  346                         .include "camera.z80"
    1                         ;=====================================================================
    2                         ; camera.z80 - level tile access, overlay and the scrolling camera
    3                         ;
    4                         ; The TMS9918A has no scroll registers: PNT column x always shows
    5                         ; level column cam+x, so every camera-column change repaints the
    6                         ; whole 32-column window. The row-major sweep in RedrawWindow costs
    7                         ; ~30k T-states (half a frame), so the full redraw fits in one
    8                         ; vblank period even at top run speed, where a camera column lasts
    9                         ; two frames - the screen is never partially stale.
   10                         ;=====================================================================
   11
   12                         ; d = column, e = row -> a = tile (overlay first, then ROM)
   13                         TileAt:
   14 061d 2140c0             	ld	hl, OVL_BASE
   15                         ta_l:
   16 0620 7e                 	ld	a, (hl)
   17 0621 feff               	cp	$FF
   18 0623 2814               	jr	z, ta_rom
   19 0625 ba                 	cp	d
   20 0626 200c               	jr	nz, ta_n
   21 0628 23                 	inc	hl
   22 0629 7e                 	ld	a, (hl)
   23 062a 2b                 	dec	hl
   24 062b bb                 	cp	e
   25 062c 2006               	jr	nz, ta_n
   26 062e 23                 	inc	hl
   27 062f 23                 	inc	hl
   28 0630 7e                 	ld	a, (hl)
   29 0631 2b                 	dec	hl
   30 0632 2b                 	dec	hl
   31 0633 c9                 	ret
   32                         ta_n:
   33 0634 23                 	inc	hl
   34 0635 23                 	inc	hl
   35 0636 23                 	inc	hl
   36 0637 18e7               	jr	ta_l
   37                         ta_rom:
   38 0639 d5                 	push	de
   39 063a 2600               	ld	h, 0
   40 063c 6a                 	ld	l, d
   41 063d 29                 	add	hl, hl		; x2
   42 063e 29                 	add	hl, hl		; x4
   43 063f 29                 	add	hl, hl		; x8
   44 0640 54                 	ld	d, h
   45 0641 5d                 	ld	e, l
   46 0642 29                 	add	hl, hl		; x16
   47 0643 19                 	add	hl, de		; x24
   48 0644 d1                 	pop	de
   49 0645 1600               	ld	d, 0
   50 0647 19                 	add	hl, de
   51 0648 118055             	ld	de, LevelData
   52 064b 19                 	add	hl, de
   53 064c 7e                 	ld	a, (hl)
   54 064d c9                 	ret
   55
   56                         ; d = column, e = row, c = new tile
   57                         OvlSet:
   58 064e 2140c0             	ld	hl, OVL_BASE
   59                         os_l:
   60 0651 7e                 	ld	a, (hl)
   61 0652 feff               	cp	$FF
   62 0654 2812               	jr	z, os_add
   63 0656 ba                 	cp	d
   64 0657 200a               	jr	nz, os_n
   65 0659 23                 	inc	hl
   66 065a 7e                 	ld	a, (hl)
   67 065b 2b                 	dec	hl
   68 065c bb                 	cp	e
   69 065d 2004               	jr	nz, os_n
   70 065f 23                 	inc	hl
   71 0660 23                 	inc	hl
   72 0661 71                 	ld	(hl), c
   73 0662 c9                 	ret
   74                         os_n:
   75 0663 23                 	inc	hl
   76 0664 23                 	inc	hl
   77 0665 23                 	inc	hl
   78 0666 18e9               	jr	os_l
   79                         os_add:
   80 0668 72                 	ld	(hl), d
   81 0669 23                 	inc	hl
   82 066a 73                 	ld	(hl), e
   83 066b 23                 	inc	hl
   84 066c 71                 	ld	(hl), c
   85 066d 23                 	inc	hl
   86 066e 36ff               	ld	(hl), $FF
   87 0670 2223c0             	ld	(ovlEnd), hl
   88 0673 c9                 	ret
   89
   90                         ; Full background redraw. The TMS9918A has no scroll registers: PNT
   91                         ; column x always shows level column cam+x, so every camera-column
   92                         ; change must repaint the whole 32-column window. The sweep is row
   93                         ; major: one VDP address set per row, then 32 back-to-back data
   94                         ; writes (the VDP auto-increments), source stride 24. Rows 0-3 are
   95                         ; permanent sky (PNT cleared at boot, never redrawn).
   96                         ; Cost: 640 tiles x ~42T + overhead ~ 30k T-states: one frame.
   97                         ; tmp4 = camera column.
   98                         RedrawWindow:
   99 0674 3a22c0             	ld	a, (tmp4)
  100 0677 6f                 	ld	l, a
  101 0678 2600               	ld	h, 0
  102 067a 29                 	add	hl, hl
  103 067b 29                 	add	hl, hl
  104 067c 29                 	add	hl, hl		; *8
  105 067d 5d                 	ld	e, l
  106 067e 54                 	ld	d, h
  107 067f 29                 	add	hl, hl		; *16
  108 0680 19                 	add	hl, de		; *24
  109 0681 118055             	ld	de, LevelData
  110 0684 19                 	add	hl, de
  111 0685 2231c0             	ld	(rwBase), hl
  112 0688 218018             	ld	hl, VRAM_PNT + 4 * 32
  113 068b 222dc0             	ld	(paP), hl		; row address cursor
  114 068e 0e04               	ld	c, 4			; row
  115                         rw_row:
  116 0690 2a31c0             	ld	hl, (rwBase)
  117 0693 0600               	ld	b, 0
  118 0695 09                 	add	hl, bc		; source = base + row
  119 0696 3a2dc0             	ld	a, (paP)
  120 0699 d3bf               	out	(VDP_CTRL), a
  121 069b 3a2ec0             	ld	a, (paP + 1)
  122 069e f640               	or	$40
  123 06a0 d3bf               	out	(VDP_CTRL), a
  124 06a2 111800             	ld	de, 24		; source stride
  125 06a5 0620               	ld	b, 32
  126                         rw_x:
  127 06a7 7e                 	ld	a, (hl)
  128 06a8 d3be               	out	(VDP_DATA), a
  129 06aa 19                 	add	hl, de
  130 06ab 10fa               	djnz	rw_x
  131 06ad 3a2dc0             	ld	a, (paP)
  132 06b0 c620               	add	a, 32
  133 06b2 322dc0             	ld	(paP), a
  134 06b5 3a2ec0             	ld	a, (paP + 1)
  135 06b8 ce00               	adc	a, 0
  136 06ba 322ec0             	ld	(paP + 1), a
  137 06bd 0c                 	inc	c
  138 06be 79                 	ld	a, c
  139 06bf fe18               	cp	24
  140 06c1 20cd               	jr	nz, rw_row
  141 06c3 c9                 	ret
  142
  143                         ; repaint overlay entries (used blocks, collected coins) over the ROM
  144                         ; sweep; slot = (col, row, tile), col $FF terminates
  145                         RedrawOvl:
  146 06c4 2140c0             	ld	hl, OVL_BASE
  147                         ro_l:
  148 06c7 7e                 	ld	a, (hl)
  149 06c8 feff               	cp	$FF
  150 06ca c8                 	ret	z
  151 06cb 321fc0             	ld	(tmp1), a		; col
  152 06ce 23                 	inc	hl
  153 06cf 7e                 	ld	a, (hl)
  154 06d0 3220c0             	ld	(tmp2), a		; row
  155 06d3 23                 	inc	hl
  156 06d4 7e                 	ld	a, (hl)
  157 06d5 3221c0             	ld	(tmp3), a		; tile
  158 06d8 23                 	inc	hl
  159 06d9 e5                 	push	hl
  160 06da 3a22c0             	ld	a, (tmp4)
  161 06dd 5f                 	ld	e, a
  162 06de 3a1fc0             	ld	a, (tmp1)
  163 06e1 93                 	sub	e
  164 06e2 3828               	jr	c, ro_next		; left of window
  165 06e4 fe20               	cp	32
  166 06e6 3024               	jr	nc, ro_next		; right of window
  167 06e8 5f                 	ld	e, a			; screen x
  168 06e9 3a20c0             	ld	a, (tmp2)
  169 06ec fe04               	cp	4
  170 06ee 381c               	jr	c, ro_next
  171 06f0 fe18               	cp	24
  172 06f2 3018               	jr	nc, ro_next
  173 06f4 57                 	ld	d, a			; row
  174 06f5 2600               	ld	h, 0
  175 06f7 6a                 	ld	l, d
  176 06f8 29                 	add	hl, hl
  177 06f9 29                 	add	hl, hl
  178 06fa 29                 	add	hl, hl
  179 06fb 29                 	add	hl, hl
  180 06fc 29                 	add	hl, hl		; row*32
  181 06fd 1600               	ld	d, 0
  182 06ff 19                 	add	hl, de
  183 0700 110018             	ld	de, VRAM_PNT
  184 0703 19                 	add	hl, de
  185 0704 cd0700             	call	VdpSetAddrW
  186 0707 3a21c0             	ld	a, (tmp3)
  187 070a d3be               	out	(VDP_DATA), a
  188                         ro_next:
  189 070c e1                 	pop	hl
  190 070d 18b8               	jr	ro_l
  191
  192                         OvlSetPoke:
  193 070f cd4e06             	call	OvlSet
  194 0712 c5                 	push	bc
  195 0713 d5                 	push	de
  196 0714 2a0fc0             	ld	hl, (cam_lo)
  197 0717 cb3c               	srl	h
  198 0719 cb1d               	rr	l
  199 071b cb3c               	srl	h
  200 071d cb1d               	rr	l
  201 071f cb3c               	srl	h
  202 0721 cb1d               	rr	l			; hl = camera column
  203 0723 7a                 	ld	a, d
  204 0724 95                 	sub	l
  205 0725 3820               	jr	c, osp_out		; left of the window
  206 0727 fe20               	cp	32
  207 0729 301c               	jr	nc, osp_out		; right of the window
  208 072b 3221c0             	ld	(tmp3), a		; screen x
  209 072e 2600               	ld	h, 0
  210 0730 6b                 	ld	l, e			; row
  211 0731 29                 	add	hl, hl
  212 0732 29                 	add	hl, hl
  213 0733 29                 	add	hl, hl
  214 0734 29                 	add	hl, hl
  215 0735 29                 	add	hl, hl		; row*32
  216 0736 3a21c0             	ld	a, (tmp3)
  217 0739 5f                 	ld	e, a
  218 073a 1600               	ld	d, 0
  219 073c 19                 	add	hl, de
  220 073d 110018             	ld	de, VRAM_PNT
  221 0740 19                 	add	hl, de
  222 0741 cd0700             	call	VdpSetAddrW
  223 0744 79                 	ld	a, c
  224 0745 d3be               	out	(VDP_DATA), a
  225                         osp_out:
  226 0747 d1                 	pop	de
  227 0748 c1                 	pop	bc
  228 0749 c9                 	ret
  229
  230                         ;=====================================================================
  231                         CameraUpdate:
  232                         	; cam = clamp(px - 96, 0, LEVEL_MAXCAM)
  233 074a 2a00c0             	ld	hl, (px_lo)
  234 074d 116000             	ld	de, 96
  235 0750 b7                 	or	a
  236 0751 ed52               	sbc	hl, de
  237 0753 cb7c               	bit	7, h
  238 0755 2803               	jr	z, cu_pos
  239 0757 210000             	ld	hl, 0
  240                         cu_pos:
  241 075a 118004             	ld	de, LEVEL_MAXCAM
  242 075d b7                 	or	a
  243 075e ed52               	sbc	hl, de
  244 0760 3003               	jr	nc, cu_max
  245 0762 19                 	add	hl, de		; below max: restore px-96
  246 0763 1803               	jr	cu_ok
  247                         cu_max:
  248 0765 218004             	ld	hl, LEVEL_MAXCAM
  249                         cu_ok:
  250 0768 220fc0             	ld	(cam_lo), hl
  251 076b cb3c               	srl	h
  252 076d cb1d               	rr	l
  253 076f cb3c               	srl	h
  254 0771 cb1d               	rr	l
  255 0773 cb3c               	srl	h
  256 0775 cb1d               	rr	l
  257 0777 7d                 	ld	a, l
  258 0778 3222c0             	ld	(tmp4), a		; new column
  259                         	; The TMS9918A has no scroll registers: PNT column x always shows
  260                         	; level column cam+x, so ANY camera-column change must repaint the
  261                         	; whole 32-column window. The row-major sweep (RedrawWindow) costs
  262                         	; ~30k T-states, so the full redraw fits in ONE frame even at run
  263                         	; speed (a camera column lasts >= 2 frames) - no conveyor, no
  264                         	; partially-stale screen.
  265 077b 3a0ec0             	ld	a, (tileColCur)
  266 077e feff               	cp	$FF
  267 0780 2806               	jr	z, cu_redraw
  268 0782 47                 	ld	b, a
  269 0783 3a22c0             	ld	a, (tmp4)
  270 0786 90                 	sub	b
  271 0787 c8                 	ret	z			; camera column unchanged
  272                         cu_redraw:
  273 0788 3a22c0             	ld	a, (tmp4)
  274 078b 320ec0             	ld	(tileColCur), a
  275 078e cd7406             	call	RedrawWindow
  276 0791 cdc406             	call	RedrawOvl
  277 0794 c9                 	ret
  278                        *END INCLUDE src/camera.z80
  347                         .include "mario_draw.z80"
    1                         ;=====================================================================
    2                         ; mario_draw.z80 - animation frame choice + 3-sprite, 3-colour draw
    3                         ;
    4                         ; The TMS9918A gives every sprite exactly one colour, so SMB3 Mario is
    5                         ; composited from three stacked 16x16 sprites (red / skin / dark),
    6                         ; which is exactly the three non-transparent colours of his NES
    7                         ; palette ($16 red, $36 skin, $0F dark).
    8                         ;=====================================================================
    9
   10                         DrawMario:
   11                         	; ---- choose frame
   12 0795 3a08c0             	ld	a, (inair)
   13 0798 b7                 	or	a
   14 0799 2024               	jr	nz, dm_fjump
   15 079b 3a27c0             	ld	a, (skidNow)
   16 079e b7                 	or	a
   17 079f 2022               	jr	nz, dm_fskid
   18 07a1 cd8201             	call	AbsXVel
   19 07a4 b7                 	or	a
   20 07a5 2820               	jr	z, dm_fstand
   21 07a7 fe19               	cp	P_TOPWALK + 1
   22 07a9 3005               	jr	nc, dm_run
   23 07ab 211506             	ld	hl, WalkCycle
   24 07ae 1803               	jr	dm_cyc
   25                         dm_run:
   26 07b0 211906             	ld	hl, RunCycle
   27                         dm_cyc:
   28 07b3 3a0cc0             	ld	a, (animIdx)
   29 07b6 e603               	and	3
   30 07b8 5f                 	ld	e, a
   31 07b9 1600               	ld	d, 0
   32 07bb 19                 	add	hl, de
   33 07bc 7e                 	ld	a, (hl)
   34 07bd 180a               	jr	dm_set
   35                         dm_fjump:
   36 07bf 3e02               	ld	a, F_JUMP
   37 07c1 1806               	jr	dm_set
   38                         dm_fskid:
   39 07c3 3e03               	ld	a, F_SKID
   40 07c5 1802               	jr	dm_set
   41                         dm_fstand:
   42 07c7 3e00               	ld	a, F_STAND
   43                         dm_set:
   44 07c9 320dc0             	ld	(frameCur), a
   45
   46                         	; ---- advance walk/run animation tick
   47 07cc cd8201             	call	AbsXVel
   48 07cf b7                 	or	a
   49 07d0 281f               	jr	z, dm_sat
   50 07d2 1f                 	rra
   51 07d3 1f                 	rra
   52 07d4 1f                 	rra			; |xvel| >> 3
   53 07d5 fe09               	cp	9
   54 07d7 3802               	jr	c, dm_t1
   55 07d9 3e08               	ld	a, 8
   56                         dm_t1:
   57 07db 5f                 	ld	e, a
   58 07dc 1600               	ld	d, 0
   59 07de 21fc05             	ld	hl, WalkTickMax
   60 07e1 19                 	add	hl, de
   61 07e2 46                 	ld	b, (hl)
   62 07e3 210bc0             	ld	hl, animTick
   63 07e6 34                 	inc	(hl)
   64 07e7 7e                 	ld	a, (hl)
   65 07e8 b8                 	cp	b
   66 07e9 3806               	jr	c, dm_sat
   67 07eb 3600               	ld	(hl), 0
   68 07ed 210cc0             	ld	hl, animIdx
   69 07f0 34                 	inc	(hl)
   70                         dm_sat:
   71                         	; ---- screen position
   72 07f1 2a00c0             	ld	hl, (px_lo)
   73 07f4 ed5b0fc0           	ld	de, (cam_lo)
   74 07f8 b7                 	or	a
   75 07f9 ed52               	sbc	hl, de
   76 07fb 7d                 	ld	a, l
   77 07fc 3226c0             	ld	(scrX), a
   78
   79                         	; ---- facing
   80 07ff 3a11c0             	ld	a, (pad)
   81 0802 e603               	and	PAD_LEFT | PAD_RIGHT
   82 0804 280f               	jr	z, dm_out
   83 0806 e602               	and	PAD_LEFT
   84 0808 2807               	jr	z, dm_fr
   85 080a 3e01               	ld	a, 1
   86 080c 320ac0             	ld	(facing), a
   87 080f 1804               	jr	dm_out
   88                         dm_fr:
   89 0811 af                 	xor	a
   90 0812 320ac0             	ld	(facing), a
   91                         dm_out:
   92                         	; ---- write the three sprite attributes
   93 0815 21003f             	ld	hl, VRAM_SAT
   94 0818 cd0700             	call	VdpSetAddrW
   95 081b 3a0dc0             	ld	a, (frameCur)
   96 081e 47                 	ld	b, a
   97 081f 87                 	add	a, a		; x2
   98 0820 87                 	add	a, a		; x4
   99 0821 4f                 	ld	c, a
  100 0822 78                 	ld	a, b
  101 0823 87                 	add	a, a		; x2
  102 0824 81                 	add	a, c		; x6
  103 0825 47                 	ld	b, a
  104 0826 3a0ac0             	ld	a, (facing)
  105 0829 b7                 	or	a
  106 082a 2804               	jr	z, dm_g0
  107 082c 3e03               	ld	a, 3
  108 082e 80                 	add	a, b
  109 082f 47                 	ld	b, a		; group base = frame*6 + facing*3
  110                         dm_g0:
  111 0830 3a02c0             	ld	a, (py_lo)
  112 0833 3d                 	dec	a
  113 0834 3222c0             	ld	(tmp4), a		; SAT Y (TMS: screen y = Y+1)
  114 0837 3a26c0             	ld	a, (scrX)
  115 083a 3221c0             	ld	(tmp3), a		; SAT X
  116 083d 0e00               	ld	c, 0		; layer
  117                         dm_l:
  118 083f 3a22c0             	ld	a, (tmp4)
  119 0842 d3be               	out	(VDP_DATA), a
  120 0844 3a21c0             	ld	a, (tmp3)
  121 0847 d3be               	out	(VDP_DATA), a
  122 0849 78                 	ld	a, b
  123 084a 81                 	add	a, c		; group
  124 084b 87                 	add	a, a
  125 084c 87                 	add	a, a		; pattern byte = group * 4
  126 084d d3be               	out	(VDP_DATA), a
  127 084f 59                 	ld	e, c
  128 0850 1600               	ld	d, 0
  129 0852 216008             	ld	hl, MarioCols
  130 0855 19                 	add	hl, de
  131 0856 7e                 	ld	a, (hl)
  132 0857 d3be               	out	(VDP_DATA), a
  133 0859 0c                 	inc	c
  134 085a 79                 	ld	a, c
  135 085b fe03               	cp	3
  136 085d 20e0               	jr	nz, dm_l
  137                         	; ---- keep the remaining sprites hidden (written once at boot,
  138                         	;      but re-assert in case anything ever touches them)
  139 085f c9                 	ret
  140
  141                         MarioCols:
  142 0860 080b01             	.db MARIO_COL_RED, MARIO_COL_SKIN, MARIO_COL_DARK
  143                        *END INCLUDE src/mario_draw.z80
  348                         .include "sound.z80"
    1                         ;=====================================================================
    2                         ; sound.z80 - SN76489 PSG effects for the SG-1000 port
    3                         ;
    4                         ; Four voices map onto the four PSG channels.  Each effect is a
    5                         ; stream of per-frame byte bursts:  <count> <bytes...> ... 0 = end.
    6                         ; The envelopes below are original designs written for this port.
    7                         ;=====================================================================
    8
    9                         SndPlayJump:
   10 0863 211a09             	ld	hl, SndJump
   11 0866 2217c0             	ld	(sndPtr0), hl
   12 0869 c9                 	ret
   13
   14                         SndPlayCoin:
   15 086a 213309             	ld	hl, SndCoin
   16 086d 2219c0             	ld	(sndPtr1), hl
   17 0870 c9                 	ret
   18
   19                         SndPlayBump:
   20 0871 214c09             	ld	hl, SndBump
   21 0874 221bc0             	ld	(sndPtr2), hl
   22 0877 c9                 	ret
   23
   24                         SndPlaySkid:
   25 0878 215c09             	ld	hl, SndSkid
   26 087b 221dc0             	ld	(sndPtr3), hl
   27 087e c9                 	ret
   28
   29                         ;=====================================================================
   30                         SoundUpdate:
   31                         	; ---- voice 0 (ch0 tone): jump
   32 087f 2a17c0             	ld	hl, (sndPtr0)
   33 0882 7c                 	ld	a, h
   34 0883 b5                 	or	l
   35 0884 281f               	jr	z, su1
   36 0886 7e                 	ld	a, (hl)
   37 0887 23                 	inc	hl
   38 0888 b7                 	or	a
   39 0889 280f               	jr	z, su0_stop
   40 088b 4f                 	ld	c, a
   41                         su0_l:
   42 088c 7e                 	ld	a, (hl)
   43 088d d37f               	out	(PSG_PORT), a
   44 088f 23                 	inc	hl
   45 0890 0d                 	dec	c
   46 0891 20f9               	jr	nz, su0_l
   47 0893 eb                 	ex	de, hl
   48 0894 ed5317c0           	ld	(sndPtr0), de
   49 0898 180b               	jr	su1
   50                         su0_stop:
   51 089a af                 	xor	a
   52 089b 3217c0             	ld	(sndPtr0), a
   53 089e 3218c0             	ld	(sndPtr0 + 1), a
   54 08a1 3e9f               	ld	a, $9F
   55 08a3 d37f               	out	(PSG_PORT), a
   56
   57                         	; ---- voice 1 (ch1 tone): coin
   58                         su1:
   59 08a5 2a19c0             	ld	hl, (sndPtr1)
   60 08a8 7c                 	ld	a, h
   61 08a9 b5                 	or	l
   62 08aa 281f               	jr	z, su2
   63 08ac 7e                 	ld	a, (hl)
   64 08ad 23                 	inc	hl
   65 08ae b7                 	or	a
   66 08af 280f               	jr	z, su1_stop
   67 08b1 4f                 	ld	c, a
   68                         su1_l:
   69 08b2 7e                 	ld	a, (hl)
   70 08b3 d37f               	out	(PSG_PORT), a
   71 08b5 23                 	inc	hl
   72 08b6 0d                 	dec	c
   73 08b7 20f9               	jr	nz, su1_l
   74 08b9 eb                 	ex	de, hl
   75 08ba ed5319c0           	ld	(sndPtr1), de
   76 08be 180b               	jr	su2
   77                         su1_stop:
   78 08c0 af                 	xor	a
   79 08c1 3219c0             	ld	(sndPtr1), a
   80 08c4 321ac0             	ld	(sndPtr1 + 1), a
   81 08c7 3ebf               	ld	a, $BF
   82 08c9 d37f               	out	(PSG_PORT), a
   83
   84                         	; ---- voice 2 (ch2 tone): bump
   85                         su2:
   86 08cb 2a1bc0             	ld	hl, (sndPtr2)
   87 08ce 7c                 	ld	a, h
   88 08cf b5                 	or	l
   89 08d0 281f               	jr	z, su3
   90 08d2 7e                 	ld	a, (hl)
   91 08d3 23                 	inc	hl
   92 08d4 b7                 	or	a
   93 08d5 280f               	jr	z, su2_stop
   94 08d7 4f                 	ld	c, a
   95                         su2_l:
   96 08d8 7e                 	ld	a, (hl)
   97 08d9 d37f               	out	(PSG_PORT), a
   98 08db 23                 	inc	hl
   99 08dc 0d                 	dec	c
  100 08dd 20f9               	jr	nz, su2_l
  101 08df eb                 	ex	de, hl
  102 08e0 ed531bc0           	ld	(sndPtr2), de
  103 08e4 180b               	jr	su3
  104                         su2_stop:
  105 08e6 af                 	xor	a
  106 08e7 321bc0             	ld	(sndPtr2), a
  107 08ea 321cc0             	ld	(sndPtr2 + 1), a
  108 08ed 3edf               	ld	a, $DF
  109 08ef d37f               	out	(PSG_PORT), a
  110
  111                         	; ---- voice 3 (ch3 noise): skid
  112                         su3:
  113 08f1 2a1dc0             	ld	hl, (sndPtr3)
