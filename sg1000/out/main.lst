  344                         .include "camera.z80"
    1                         ;=====================================================================
    2                         ; camera.z80 - level tile access, overlay and the scrolling camera
    3                         ;
    4                         ; The TMS9918A has no scroll registers, so the camera streams whole
    5                         ; name-table columns (24 bytes each) as it crosses tile boundaries,
    6                         ; exactly like SG-1000 games of the era did.
    7                         ;=====================================================================
    8
    9                         ; d = column, e = row -> a = tile (overlay first, then ROM)
   10                         TileAt:
   11 061d 2140c0             	ld	hl, OVL_BASE
   12                         ta_l:
   13 0620 7e                 	ld	a, (hl)
   14 0621 feff               	cp	$FF
   15 0623 2814               	jr	z, ta_rom
   16 0625 ba                 	cp	d
   17 0626 200c               	jr	nz, ta_n
   18 0628 23                 	inc	hl
   19 0629 7e                 	ld	a, (hl)
   20 062a 2b                 	dec	hl
   21 062b bb                 	cp	e
   22 062c 2006               	jr	nz, ta_n
   23 062e 23                 	inc	hl
   24 062f 23                 	inc	hl
   25 0630 7e                 	ld	a, (hl)
   26 0631 2b                 	dec	hl
   27 0632 2b                 	dec	hl
   28 0633 c9                 	ret
   29                         ta_n:
   30 0634 23                 	inc	hl
   31 0635 23                 	inc	hl
   32 0636 23                 	inc	hl
   33 0637 18e7               	jr	ta_l
   34                         ta_rom:
   35 0639 d5                 	push	de
   36 063a 2600               	ld	h, 0
   37 063c 6a                 	ld	l, d
   38 063d 29                 	add	hl, hl		; x2
   39 063e 29                 	add	hl, hl		; x4
   40 063f 29                 	add	hl, hl		; x8
   41 0640 54                 	ld	d, h
   42 0641 5d                 	ld	e, l
   43 0642 29                 	add	hl, hl		; x16
   44 0643 19                 	add	hl, de		; x24
   45 0644 d1                 	pop	de
   46 0645 1600               	ld	d, 0
   47 0647 19                 	add	hl, de
   48 0648 118055             	ld	de, LevelData
   49 064b 19                 	add	hl, de
   50 064c 7e                 	ld	a, (hl)
   51 064d c9                 	ret
   52
   53                         ; d = column, e = row, c = new tile
   54                         OvlSet:
   55 064e 2140c0             	ld	hl, OVL_BASE
   56                         os_l:
   57 0651 7e                 	ld	a, (hl)
   58 0652 feff               	cp	$FF
   59 0654 2812               	jr	z, os_add
   60 0656 ba                 	cp	d
   61 0657 200a               	jr	nz, os_n
   62 0659 23                 	inc	hl
   63 065a 7e                 	ld	a, (hl)
   64 065b 2b                 	dec	hl
   65 065c bb                 	cp	e
   66 065d 2004               	jr	nz, os_n
   67 065f 23                 	inc	hl
   68 0660 23                 	inc	hl
   69 0661 71                 	ld	(hl), c
   70 0662 c9                 	ret
   71                         os_n:
   72 0663 23                 	inc	hl
   73 0664 23                 	inc	hl
   74 0665 23                 	inc	hl
   75 0666 18e9               	jr	os_l
   76                         os_add:
   77 0668 72                 	ld	(hl), d
   78 0669 23                 	inc	hl
   79 066a 73                 	ld	(hl), e
   80 066b 23                 	inc	hl
   81 066c 71                 	ld	(hl), c
   82 066d 23                 	inc	hl
   83 066e 36ff               	ld	(hl), $FF
   84 0670 2223c0             	ld	(ovlEnd), hl
   85 0673 c9                 	ret
   86
   87                         ; draw one screen column; level column in (tmp1), screen x in (tmp3)
   88                         DrawColumn:
   89 0674 0e00               	ld	c, 0			; row
   90                         dc_l:
   91 0676 3a1fc0             	ld	a, (tmp1)
   92 0679 57                 	ld	d, a
   93 067a 79                 	ld	a, c
   94 067b 5f                 	ld	e, a
   95 067c cd1d06             	call	TileAt
   96 067f 3222c0             	ld	(tmp4), a
   97 0682 2600               	ld	h, 0
   98 0684 69                 	ld	l, c
   99 0685 29                 	add	hl, hl
  100 0686 29                 	add	hl, hl
  101 0687 29                 	add	hl, hl
  102 0688 29                 	add	hl, hl
  103 0689 29                 	add	hl, hl		; row * 32
  104 068a 3a21c0             	ld	a, (tmp3)
  105 068d 5f                 	ld	e, a
  106 068e 1600               	ld	d, 0
  107 0690 19                 	add	hl, de
  108 0691 110018             	ld	de, VRAM_PNT
  109 0694 19                 	add	hl, de
  110 0695 cd0700             	call	VdpSetAddrW
  111 0698 3a22c0             	ld	a, (tmp4)
  112 069b d3be               	out	(VDP_DATA), a
  113 069d 0c                 	inc	c
  114 069e 79                 	ld	a, c
  115 069f fe18               	cp	24
  116 06a1 20d3               	jr	nz, dc_l
  117 06a3 c9                 	ret
  118
  119                         ;=====================================================================
  120                         CameraUpdate:
  121                         	; cam = clamp(px - 96, 0, LEVEL_MAXCAM)
  122 06a4 2a00c0             	ld	hl, (px_lo)
  123 06a7 116000             	ld	de, 96
  124 06aa b7                 	or	a
  125 06ab ed52               	sbc	hl, de
  126 06ad cb7c               	bit	7, h
  127 06af 2803               	jr	z, cu_pos
  128 06b1 210000             	ld	hl, 0
  129                         cu_pos:
  130 06b4 118004             	ld	de, LEVEL_MAXCAM
  131 06b7 b7                 	or	a
  132 06b8 ed52               	sbc	hl, de
  133 06ba 3003               	jr	nc, cu_max
  134 06bc 19                 	add	hl, de		; below max: restore px-96
  135 06bd 1803               	jr	cu_ok
  136                         cu_max:
  137 06bf 218004             	ld	hl, LEVEL_MAXCAM
  138                         cu_ok:
  139 06c2 220fc0             	ld	(cam_lo), hl
  140 06c5 cb3c               	srl	h
  141 06c7 cb1d               	rr	l
  142 06c9 cb3c               	srl	h
  143 06cb cb1d               	rr	l
  144 06cd cb3c               	srl	h
  145 06cf cb1d               	rr	l
  146 06d1 7d                 	ld	a, l
  147 06d2 3222c0             	ld	(tmp4), a		; new column
  148 06d5 3a0ec0             	ld	a, (tileColCur)
  149 06d8 feff               	cp	$FF
  150 06da 2852               	jr	z, cu_full
  151 06dc 47                 	ld	b, a
  152 06dd 3a22c0             	ld	a, (tmp4)
  153 06e0 90                 	sub	b
  154 06e1 2869               	jr	z, cu_done
  155 06e3 4f                 	ld	c, a			; signed delta
  156 06e4 cb7f               	bit	7, a
  157 06e6 2802               	jr	z, cu_abs
  158 06e8 ed44               	neg
  159                         cu_abs:
  160 06ea fe20               	cp	32
  161 06ec 3040               	jr	nc, cu_full
  162 06ee 79                 	ld	a, c
  163 06ef cb7f               	bit	7, a
  164 06f1 201f               	jr	nz, cu_left
  165                         	; moved right: new columns enter at the right edge
  166 06f3 47                 	ld	b, a
  167 06f4 3e20               	ld	a, 32
  168 06f6 90                 	sub	b
  169 06f7 57                 	ld	d, a			; first screen x to refresh
  170                         cu_rl:
  171 06f8 7a                 	ld	a, d
  172 06f9 3221c0             	ld	(tmp3), a
  173 06fc 3a22c0             	ld	a, (tmp4)
  174 06ff 82                 	add	a, d
  175 0700 321fc0             	ld	(tmp1), a
  176 0703 d5                 	push	de
  177 0704 c5                 	push	bc
  178 0705 cd7406             	call	DrawColumn
  179 0708 c1                 	pop	bc
  180 0709 d1                 	pop	de
  181 070a 14                 	inc	d
  182 070b 7a                 	ld	a, d
  183 070c fe20               	cp	32
  184 070e 20e8               	jr	nz, cu_rl
  185 0710 1834               	jr	cu_set
  186                         cu_left:
  187                         	; moved left: new columns enter at the left edge
  188 0712 ed44               	neg
  189 0714 47                 	ld	b, a
  190 0715 1600               	ld	d, 0
  191                         cu_ll:
  192 0717 7a                 	ld	a, d
  193 0718 3221c0             	ld	(tmp3), a
  194 071b 3a22c0             	ld	a, (tmp4)
  195 071e 82                 	add	a, d
  196 071f 321fc0             	ld	(tmp1), a
  197 0722 d5                 	push	de
  198 0723 c5                 	push	bc
  199 0724 cd7406             	call	DrawColumn
  200 0727 c1                 	pop	bc
  201 0728 d1                 	pop	de
  202 0729 14                 	inc	d
  203 072a 10eb               	djnz	cu_ll
  204 072c 1818               	jr	cu_set
  205                         cu_full:
  206 072e 0600               	ld	b, 0
  207                         cf_l:
  208 0730 78                 	ld	a, b
  209 0731 3221c0             	ld	(tmp3), a
  210 0734 3a22c0             	ld	a, (tmp4)
  211 0737 80                 	add	a, b
  212 0738 321fc0             	ld	(tmp1), a
  213 073b c5                 	push	bc
  214 073c cd7406             	call	DrawColumn
  215 073f c1                 	pop	bc
  216 0740 04                 	inc	b
  217 0741 78                 	ld	a, b
  218 0742 fe20               	cp	32
  219 0744 20ea               	jr	nz, cf_l
  220                         cu_set:
  221 0746 3a22c0             	ld	a, (tmp4)
  222 0749 320ec0             	ld	(tileColCur), a
  223                         cu_done:
  224 074c c9                 	ret
  225                        *END INCLUDE src/camera.z80
  345                         .include "mario_draw.z80"
    1                         ;=====================================================================
    2                         ; mario_draw.z80 - animation frame choice + 3-sprite, 3-colour draw
    3                         ;
    4                         ; The TMS9918A gives every sprite exactly one colour, so SMB3 Mario is
    5                         ; composited from three stacked 16x16 sprites (red / skin / dark),
    6                         ; which is exactly the three non-transparent colours of his NES
    7                         ; palette ($16 red, $36 skin, $0F dark).
    8                         ;=====================================================================
    9
   10                         DrawMario:
   11                         	; ---- choose frame
   12 074d 3a08c0             	ld	a, (inair)
   13 0750 b7                 	or	a
   14 0751 2024               	jr	nz, dm_fjump
   15 0753 3a27c0             	ld	a, (skidNow)
   16 0756 b7                 	or	a
   17 0757 2022               	jr	nz, dm_fskid
   18 0759 cd8201             	call	AbsXVel
   19 075c b7                 	or	a
   20 075d 2820               	jr	z, dm_fstand
   21 075f fe19               	cp	P_TOPWALK + 1
   22 0761 3005               	jr	nc, dm_run
   23 0763 211506             	ld	hl, WalkCycle
   24 0766 1803               	jr	dm_cyc
   25                         dm_run:
   26 0768 211906             	ld	hl, RunCycle
   27                         dm_cyc:
   28 076b 3a0cc0             	ld	a, (animIdx)
   29 076e e603               	and	3
   30 0770 5f                 	ld	e, a
   31 0771 1600               	ld	d, 0
   32 0773 19                 	add	hl, de
   33 0774 7e                 	ld	a, (hl)
   34 0775 180a               	jr	dm_set
   35                         dm_fjump:
   36 0777 3e02               	ld	a, F_JUMP
   37 0779 1806               	jr	dm_set
   38                         dm_fskid:
   39 077b 3e03               	ld	a, F_SKID
   40 077d 1802               	jr	dm_set
   41                         dm_fstand:
   42 077f 3e00               	ld	a, F_STAND
   43                         dm_set:
   44 0781 320dc0             	ld	(frameCur), a
   45
   46                         	; ---- advance walk/run animation tick
   47 0784 cd8201             	call	AbsXVel
   48 0787 b7                 	or	a
   49 0788 281f               	jr	z, dm_sat
   50 078a 1f                 	rra
   51 078b 1f                 	rra
   52 078c 1f                 	rra			; |xvel| >> 3
   53 078d fe09               	cp	9
   54 078f 3802               	jr	c, dm_t1
   55 0791 3e08               	ld	a, 8
   56                         dm_t1:
   57 0793 5f                 	ld	e, a
   58 0794 1600               	ld	d, 0
   59 0796 21fc05             	ld	hl, WalkTickMax
   60 0799 19                 	add	hl, de
   61 079a 46                 	ld	b, (hl)
   62 079b 210bc0             	ld	hl, animTick
   63 079e 34                 	inc	(hl)
   64 079f 7e                 	ld	a, (hl)
   65 07a0 b8                 	cp	b
   66 07a1 3806               	jr	c, dm_sat
   67 07a3 3600               	ld	(hl), 0
   68 07a5 210cc0             	ld	hl, animIdx
   69 07a8 34                 	inc	(hl)
   70                         dm_sat:
   71                         	; ---- screen position
   72 07a9 2a00c0             	ld	hl, (px_lo)
   73 07ac ed5b0fc0           	ld	de, (cam_lo)
   74 07b0 b7                 	or	a
   75 07b1 ed52               	sbc	hl, de
   76 07b3 7d                 	ld	a, l
   77 07b4 3226c0             	ld	(scrX), a
   78
   79                         	; ---- facing
   80 07b7 3a11c0             	ld	a, (pad)
   81 07ba e603               	and	PAD_LEFT | PAD_RIGHT
   82 07bc 280f               	jr	z, dm_out
   83 07be e602               	and	PAD_LEFT
   84 07c0 2807               	jr	z, dm_fr
   85 07c2 3e01               	ld	a, 1
   86 07c4 320ac0             	ld	(facing), a
   87 07c7 1804               	jr	dm_out
   88                         dm_fr:
   89 07c9 af                 	xor	a
   90 07ca 320ac0             	ld	(facing), a
   91                         dm_out:
   92                         	; ---- write the three sprite attributes
   93 07cd 21003f             	ld	hl, VRAM_SAT
   94 07d0 cd0700             	call	VdpSetAddrW
   95 07d3 3a0dc0             	ld	a, (frameCur)
   96 07d6 47                 	ld	b, a
   97 07d7 87                 	add	a, a		; x2
   98 07d8 87                 	add	a, a		; x4
   99 07d9 4f                 	ld	c, a
  100 07da 78                 	ld	a, b
  101 07db 87                 	add	a, a		; x2
  102 07dc 81                 	add	a, c		; x6
  103 07dd 47                 	ld	b, a
  104 07de 3a0ac0             	ld	a, (facing)
  105 07e1 b7                 	or	a
  106 07e2 2804               	jr	z, dm_g0
  107 07e4 3e03               	ld	a, 3
  108 07e6 80                 	add	a, b
  109 07e7 47                 	ld	b, a		; group base = frame*6 + facing*3
  110                         dm_g0:
  111 07e8 3a02c0             	ld	a, (py_lo)
  112 07eb 3d                 	dec	a
  113 07ec 3222c0             	ld	(tmp4), a		; SAT Y (TMS: screen y = Y+1)
  114 07ef 3a26c0             	ld	a, (scrX)
  115 07f2 3221c0             	ld	(tmp3), a		; SAT X
  116 07f5 0e00               	ld	c, 0		; layer
  117                         dm_l:
  118 07f7 3a22c0             	ld	a, (tmp4)
  119 07fa d3be               	out	(VDP_DATA), a
  120 07fc 3a21c0             	ld	a, (tmp3)
  121 07ff d3be               	out	(VDP_DATA), a
  122 0801 78                 	ld	a, b
  123 0802 81                 	add	a, c		; group
  124 0803 87                 	add	a, a
  125 0804 87                 	add	a, a		; pattern byte = group * 4
  126 0805 d3be               	out	(VDP_DATA), a
  127 0807 59                 	ld	e, c
  128 0808 1600               	ld	d, 0
  129 080a 211808             	ld	hl, MarioCols
  130 080d 19                 	add	hl, de
  131 080e 7e                 	ld	a, (hl)
  132 080f d3be               	out	(VDP_DATA), a
  133 0811 0c                 	inc	c
  134 0812 79                 	ld	a, c
  135 0813 fe03               	cp	3
  136 0815 20e0               	jr	nz, dm_l
  137                         	; ---- keep the remaining sprites hidden (written once at boot,
  138                         	;      but re-assert in case anything ever touches them)
  139 0817 c9                 	ret
  140
  141                         MarioCols:
  142 0818 080b01             	.db MARIO_COL_RED, MARIO_COL_SKIN, MARIO_COL_DARK
  143                        *END INCLUDE src/mario_draw.z80
  346                         .include "sound.z80"
    1                         ;=====================================================================
    2                         ; sound.z80 - SN76489 PSG effects for the SG-1000 port
    3                         ;
    4                         ; Four voices map onto the four PSG channels.  Each effect is a
    5                         ; stream of per-frame byte bursts:  <count> <bytes...> ... 0 = end.
    6                         ; The envelopes below are original designs written for this port.
    7                         ;=====================================================================
    8
    9                         SndPlayJump:
   10 081b 21d208             	ld	hl, SndJump
   11 081e 2217c0             	ld	(sndPtr0), hl
   12 0821 c9                 	ret
   13
   14                         SndPlayCoin:
   15 0822 21eb08             	ld	hl, SndCoin
   16 0825 2219c0             	ld	(sndPtr1), hl
   17 0828 c9                 	ret
   18
   19                         SndPlayBump:
   20 0829 210409             	ld	hl, SndBump
   21 082c 221bc0             	ld	(sndPtr2), hl
   22 082f c9                 	ret
   23
   24                         SndPlaySkid:
   25 0830 211409             	ld	hl, SndSkid
   26 0833 221dc0             	ld	(sndPtr3), hl
   27 0836 c9                 	ret
   28
   29                         ;=====================================================================
   30                         SoundUpdate:
   31                         	; ---- voice 0 (ch0 tone): jump
   32 0837 2a17c0             	ld	hl, (sndPtr0)
   33 083a 7c                 	ld	a, h
   34 083b b5                 	or	l
   35 083c 281f               	jr	z, su1
   36 083e 7e                 	ld	a, (hl)
   37 083f 23                 	inc	hl
   38 0840 b7                 	or	a
   39 0841 280f               	jr	z, su0_stop
   40 0843 4f                 	ld	c, a
   41                         su0_l:
   42 0844 7e                 	ld	a, (hl)
   43 0845 d37f               	out	(PSG_PORT), a
   44 0847 23                 	inc	hl
   45 0848 0d                 	dec	c
   46 0849 20f9               	jr	nz, su0_l
   47 084b eb                 	ex	de, hl
   48 084c ed5317c0           	ld	(sndPtr0), de
   49 0850 180b               	jr	su1
   50                         su0_stop:
   51 0852 af                 	xor	a
   52 0853 3217c0             	ld	(sndPtr0), a
   53 0856 3218c0             	ld	(sndPtr0 + 1), a
   54 0859 3e9f               	ld	a, $9F
   55 085b d37f               	out	(PSG_PORT), a
   56
   57                         	; ---- voice 1 (ch1 tone): coin
   58                         su1:
   59 085d 2a19c0             	ld	hl, (sndPtr1)
   60 0860 7c                 	ld	a, h
   61 0861 b5                 	or	l
   62 0862 281f               	jr	z, su2
   63 0864 7e                 	ld	a, (hl)
   64 0865 23                 	inc	hl
   65 0866 b7                 	or	a
   66 0867 280f               	jr	z, su1_stop
   67 0869 4f                 	ld	c, a
   68                         su1_l:
   69 086a 7e                 	ld	a, (hl)
   70 086b d37f               	out	(PSG_PORT), a
   71 086d 23                 	inc	hl
   72 086e 0d                 	dec	c
   73 086f 20f9               	jr	nz, su1_l
   74 0871 eb                 	ex	de, hl
   75 0872 ed5319c0           	ld	(sndPtr1), de
   76 0876 180b               	jr	su2
   77                         su1_stop:
   78 0878 af                 	xor	a
   79 0879 3219c0             	ld	(sndPtr1), a
   80 087c 321ac0             	ld	(sndPtr1 + 1), a
   81 087f 3ebf               	ld	a, $BF
   82 0881 d37f               	out	(PSG_PORT), a
   83
   84                         	; ---- voice 2 (ch2 tone): bump
   85                         su2:
   86 0883 2a1bc0             	ld	hl, (sndPtr2)
   87 0886 7c                 	ld	a, h
   88 0887 b5                 	or	l
   89 0888 281f               	jr	z, su3
   90 088a 7e                 	ld	a, (hl)
   91 088b 23                 	inc	hl
   92 088c b7                 	or	a
   93 088d 280f               	jr	z, su2_stop
   94 088f 4f                 	ld	c, a
   95                         su2_l:
   96 0890 7e                 	ld	a, (hl)
   97 0891 d37f               	out	(PSG_PORT), a
   98 0893 23                 	inc	hl
   99 0894 0d                 	dec	c
  100 0895 20f9               	jr	nz, su2_l
  101 0897 eb                 	ex	de, hl
  102 0898 ed531bc0           	ld	(sndPtr2), de
  103 089c 180b               	jr	su3
  104                         su2_stop:
  105 089e af                 	xor	a
  106 089f 321bc0             	ld	(sndPtr2), a
  107 08a2 321cc0             	ld	(sndPtr2 + 1), a
  108 08a5 3edf               	ld	a, $DF
  109 08a7 d37f               	out	(PSG_PORT), a
  110
  111                         	; ---- voice 3 (ch3 noise): skid
  112                         su3:
  113 08a9 2a1dc0             	ld	hl, (sndPtr3)
  114 08ac 7c                 	ld	a, h
  115 08ad b5                 	or	l
  116 08ae c8                 	ret	z
  117 08af 7e                 	ld	a, (hl)
  118 08b0 23                 	inc	hl
  119 08b1 b7                 	or	a
  120 08b2 280e               	jr	z, su3_stop
  121 08b4 4f                 	ld	c, a
  122                         su3_l:
  123 08b5 7e                 	ld	a, (hl)
  124 08b6 d37f               	out	(PSG_PORT), a
  125 08b8 23                 	inc	hl
  126 08b9 0d                 	dec	c
  127 08ba 20f9               	jr	nz, su3_l
  128 08bc eb                 	ex	de, hl
  129 08bd ed531dc0           	ld	(sndPtr3), de
  130 08c1 c9                 	ret
  131                         su3_stop:
  132 08c2 af                 	xor	a
  133 08c3 321dc0             	ld	(sndPtr3), a
  134 08c6 321ec0             	ld	(sndPtr3 + 1), a
  135 08c9 3eff               	ld	a, $FF
  136 08cb d37f               	out	(PSG_PORT), a
  137 08cd c9                 	ret
  138
  139                         ;=====================================================================
  140                         ; effect streams (original envelope designs)
  141                         ;=====================================================================
  142                         PsgMute:
  143 08ce 9fbfdfff           	.db $9F, $BF, $DF, $FF
  144
  145                         ; jump: quick rising chirp on channel 0
  146                         SndJump:
  147 08d2 03908030           	.db 3, $90, $80, $30
  148 08d6 028028             	.db 2, $80, $28
  149 08d9 028020             	.db 2, $80, $20
  150 08dc 028018             	.db 2, $80, $18
  151 08df 028010             	.db 2, $80, $10
  152 08e2 02800c             	.db 2, $80, $0C
  153 08e5 028008             	.db 2, $80, $08
  154 08e8 019f               	.db 1, $9F
  155 08ea 00                 	.db 0
  156
  157                         ; coin: two-note blip on channel 1
  158                         SndCoin:
  159 08eb 03b0a00a           	.db 3, $B0, $A0, $0A
  160 08ef 02a00a             	.db 2, $A0, $0A
  161 08f2 02a00a             	.db 2, $A0, $0A
  162 08f5 02a00a             	.db 2, $A0, $0A
  163 08f8 02a006             	.db 2, $A0, $06
  164 08fb 02a006             	.db 2, $A0, $06
  165 08fe 02a006             	.db 2, $A0, $06
  166 0901 01bf               	.db 1, $BF
  167 0903 00                 	.db 0
  168
  169                         ; bump: short low thud on channel 2
  170                         SndBump:
  171 0904 03d0c03c           	.db 3, $D0, $C0, $3C
  172 0908 02c03c             	.db 2, $C0, $3C
  173 090b 02c03c             	.db 2, $C0, $3C
  174 090e 02c03c             	.db 2, $C0, $3C
  175 0911 01df               	.db 1, $DF
  176 0913 00                 	.db 0
  177
  178                         ; skid: raspy noise burst on channel 3
  179                         SndSkid:
  180 0914 02f004             	.db 2, $F0, $04
  181 0917 01f0               	.db 1, $F0
  182 0919 01f0               	.db 1, $F0
  183 091b 01f0               	.db 1, $F0
  184 091d 01ff               	.db 1, $FF
  185 091f 00                 	.db 0
  186                        *END INCLUDE src/sound.z80
  347
