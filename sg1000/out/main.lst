    1                         ;=====================================================================
    2                         ;  SMB3 -> Sega SG-1000 port : main module
    3                         ;  physics + Mario sprites (3 colours) + sounds + scrolling camera
    4                         ;  + test level.
    5                         ;
    6                         ;  Hardware: Z80 @3.58MHz, TMS9918A VDP in Graphics II, SN76489 PSG
    7                         ;  VRAM map (16K):
    8                         ;    $0000  pattern generator   (3 x 2048 sections, Graphics II)
    9                         ;    $1800  pattern name table  (32 x 24)
   10                         ;    $2000  colour table        (3 x 2048 sections)
   11                         ;    $3800  sprite patterns     (36 groups x 32 bytes = 1152)
   12                         ;    $3F00  sprite attribute table (32 x 4)
   13                         ;
   14                         ;  The physics are a direct port of PRG008 of the SMB3 disassembly
   15                         ;  carried in this repository: 4.4 fixed point velocities,
   16                         ;  fractional accumulators, the accel / pseudo-fraction tables and
   17                         ;  the Counter_Wiggly ripple carry.
   18                         ;=====================================================================
   19
   20                         ;--------------------------- I/O ports -------------------------------
   21                         VDP_DATA:	.equ $BE
   22                         VDP_CTRL:	.equ $BF
   23                         PSG_PORT:	.equ $7F
   24                         PAD_PORT:	.equ $C0
   25
   26                         ;--------------------------- VRAM bases ------------------------------
   27                         VRAM_PGT:	.equ $0000
   28                         VRAM_PNT:	.equ $1800
   29                         VRAM_CT:		.equ $2000
   30                         VRAM_SPAT:	.equ $3800
   31                         VRAM_SAT:	.equ $3F00
   32
   33                         ;--------------------------- physics (SMB3 PRG008 values) ------------
   34                         P_TOPWALK:	.equ $18	; PLAYER_TOPWALKSPEED
   35                         P_TOPRUN:	.equ $28	; PLAYER_TOPRUNSPEED
   36                         P_MAXSPEED:	.equ $40	; PLAYER_MAXSPEED
   37                         P_JUMP:		.equ $C8	; PLAYER_JUMP (-$38)
   38                         P_FALLCAP:	.equ $40
   39                         P_GRAV_AIR:	.equ $05
   40                         P_GRAV_HOLD:	.equ $01
   41                         P_JUMPFAST:	.equ $E0	; -$20
   42                         LEVEL_MAXCAM:	.equ 1152	; LEVEL_W*8-256
   43
   44                         ;--------------------------- pad bits --------------------------------
   45                         PAD_RIGHT:	.equ $01
   46                         PAD_LEFT:	.equ $02
   47                         PAD_A:		.equ $04
   48                         PAD_B:		.equ $08
   49
   50                         ;--------------------------- tiles -----------------------------------
   51                         T_BLANK:		.equ 0
   52                         T_QUEST:		.equ 4
   53                         T_USED:		.equ 5
   54                         T_COIN:		.equ 11
   55
   56                         ;--------------------------- Mario frames ----------------------------
   57                         F_STAND:		.equ 0
   58                         F_WALK1:		.equ 1
   59                         F_JUMP:		.equ 2
   60                         F_SKID:		.equ 3
   61                         F_RUN0:		.equ 4
   62                         F_RUN1:		.equ 5
   63
   64                         ;--------------------------- RAM -------------------------------------
   65                         px_lo:		.equ $C000
   66                         px_hi:		.equ $C001
   67                         py_lo:		.equ $C002
   68                         py_hi:		.equ $C003
   69                         xvel:		.equ $C004	; signed 4.4 fixed point
   70                         xfrac:		.equ $C005
   71                         yvel:		.equ $C006
   72                         yfrac:		.equ $C007
   73                         inair:		.equ $C008
   74                         onGround:	.equ $C009
   75                         facing:		.equ $C00A	; 0 right, 1 left
   76                         animTick:	.equ $C00B
   77                         animIdx:		.equ $C00C
   78                         frameCur:	.equ $C00D
   79                         tileColCur:	.equ $C00E
   80                         cam_lo:		.equ $C00F
   81                         cam_hi:		.equ $C010
   82                         pad:		.equ $C011
   83                         padPrev:		.equ $C012
   84                         padEdge:		.equ $C013
   85                         wiggly:		.equ $C014	; Counter_Wiggly port
   86                         skidOld:		.equ $C015
   87                         coinCount:	.equ $C016
   88                         sndPtr0:		.equ $C017
   89                         sndPtr1:		.equ $C019
   90                         sndPtr2:		.equ $C01B
   91                         sndPtr3:		.equ $C01D
   92                         tmp1:		.equ $C01F
   93                         tmp2:		.equ $C020
   94                         tmp3:		.equ $C021
   95                         tmp4:		.equ $C022
   96                         ovlEnd:		.equ $C023	; 2 bytes: terminator slot
   97                         frameCnt:	.equ $C025
   98                         scrX:		.equ $C026
   99                         skidNow:		.equ $C027
  100                         OVL_BASE:	.equ $C040	; 48 slots x 3 bytes
  101                         STACK_TOP:	.equ $C3FC
  102
  103                         ;=====================================================================
  104                         	.org $0000
  105 0000 f3                 	di
  106 0001 31fcc3             	ld	sp, STACK_TOP
  107 0004 c32700             	jp	Boot
  108
  109                         ;=====================================================================
  110                         ; VDP helpers
  111                         ;=====================================================================
  112                         VdpSetAddrW:				; hl = VRAM write address
  113 0007 7d                 	ld	a, l
  114 0008 d3bf               	out	(VDP_CTRL), a
  115 000a 7c                 	ld	a, h
  116 000b f640               	or	$40
  117 000d d3bf               	out	(VDP_CTRL), a
  118 000f c9                 	ret
  119
  120                         ; b = register, a = value
  121                         VdpReg:
  122 0010 d3bf               	out	(VDP_CTRL), a
  123 0012 78                 	ld	a, b
  124 0013 f680               	or	$80
  125 0015 d3bf               	out	(VDP_CTRL), a
  126 0017 c9                 	ret
  127
  128                         ; hl = source, de = VRAM dest, bc = count
  129                         VdpUpload:
  130 0018 eb                 	ex	de, hl
  131 0019 cd0700             	call	VdpSetAddrW
  132 001c eb                 	ex	de, hl
  133                         up_l:
  134 001d 7e                 	ld	a, (hl)
  135 001e d3be               	out	(VDP_DATA), a
  136 0020 23                 	inc	hl
  137 0021 0b                 	dec	bc
  138 0022 78                 	ld	a, b
  139 0023 b1                 	or	c
  140 0024 20f7               	jr	nz, up_l
  141 0026 c9                 	ret
  142
  143                         ;=====================================================================
  144                         Boot:
  145 0027 0600               	ld	b, 0			; R0 = $02 : M3 -> Graphics II
  146 0029 3e02               	ld	a, $02
  147 002b cd1000             	call	VdpReg
  148 002e 0601               	ld	b, 1			; R1: 16K, display on, 16x16 sprites
  149 0030 3ee2               	ld	a, $E2
  150 0032 cd1000             	call	VdpReg
  151 0035 0602               	ld	b, 2			; R2: PNT @ $1800
  152 0037 3e06               	ld	a, $06
  153 0039 cd1000             	call	VdpReg
  154 003c 0603               	ld	b, 3			; R3: CT @ $2000
  155 003e 3eff               	ld	a, $FF
  156 0040 cd1000             	call	VdpReg
  157 0043 0604               	ld	b, 4			; R4: PGT @ $0000
  158 0045 af                 	xor	a
  159 0046 cd1000             	call	VdpReg
  160 0049 0605               	ld	b, 5			; R5: SAT @ $3F00
  161 004b 3e7e               	ld	a, $7E
  162 004d cd1000             	call	VdpReg
  163 0050 0606               	ld	b, 6			; R6: sprite PG @ $3800
  164 0052 3e07               	ld	a, $07
  165 0054 cd1000             	call	VdpReg
  166 0057 0607               	ld	b, 7			; R7: backdrop = light blue
  167 0059 3e55               	ld	a, $55
  168 005b cd1000             	call	VdpReg
  169
  170                         	; ---- background tiles: the used tiles into each of the three
  171                         	;      Graphics II sections (PGT and CT)
  172 005e 0600               	ld	b, 0
  173                         tile_sec:
  174 0060 c5                 	push	bc
  175 0061 78                 	ld	a, b
  176 0062 87                 	add	a, a
  177 0063 87                 	add	a, a
  178 0064 87                 	add	a, a		; high byte of section offset (2048*b)
  179 0065 321fc0             	ld	(tmp1), a
  180 0068 210050             	ld	hl, TilePatternsSec
  181 006b 3a1fc0             	ld	a, (tmp1)
  182 006e 57                 	ld	d, a
  183 006f 1e00               	ld	e, 0			; VRAM_PGT + offset
  184 0071 018000             	ld	bc, 128
  185 0074 cd1800             	call	VdpUpload
  186 0077 218050             	ld	hl, TileColorsSec
  187 007a 3a1fc0             	ld	a, (tmp1)
  188 007d c620               	add	a, $20		; VRAM_CT + offset
  189 007f 57                 	ld	d, a
  190 0080 1e00               	ld	e, 0
  191 0082 018000             	ld	bc, 128
  192 0085 cd1800             	call	VdpUpload
  193 0088 c1                 	pop	bc
  194 0089 04                 	inc	b
  195 008a 78                 	ld	a, b
  196 008b fe03               	cp	3
  197 008d 20d1               	jr	nz, tile_sec
  198
  199                         	; ---- clear name table
  200 008f 210018             	ld	hl, VRAM_PNT
  201 0092 cd0700             	call	VdpSetAddrW
  202 0095 010003             	ld	bc, 768
  203 0098 1600               	ld	d, 0
  204                         pnt_clear:
  205 009a 7a                 	ld	a, d
  206 009b d3be               	out	(VDP_DATA), a
  207 009d 0b                 	dec	bc
  208 009e 78                 	ld	a, b
  209 009f b1                 	or	c
  210 00a0 20f8               	jr	nz, pnt_clear
  211
  212                         	; ---- Mario sprite patterns
  213 00a2 210051             	ld	hl, MarioPatterns
  214 00a5 110038             	ld	de, VRAM_SPAT
  215 00a8 018004             	ld	bc, 36 * 32
  216 00ab cd1800             	call	VdpUpload
  217
  218                         	; ---- hide all sprites
  219 00ae 21003f             	ld	hl, VRAM_SAT
  220 00b1 cd0700             	call	VdpSetAddrW
  221 00b4 0620               	ld	b, 32
  222                         sat_clear:
  223 00b6 3ed0               	ld	a, $D0
  224 00b8 d3be               	out	(VDP_DATA), a
  225 00ba af                 	xor	a
  226 00bb d3be               	out	(VDP_DATA), a
  227 00bd d3be               	out	(VDP_DATA), a
  228 00bf d3be               	out	(VDP_DATA), a
  229 00c1 10f3               	djnz	sat_clear
  230
  231                         	; ---- PSG mute
  232 00c3 21ce08             	ld	hl, PsgMute
  233 00c6 0604               	ld	b, 4
  234                         psg_m:
  235 00c8 7e                 	ld	a, (hl)
  236 00c9 d37f               	out	(PSG_PORT), a
  237 00cb 23                 	inc	hl
  238 00cc 10fa               	djnz	psg_m
  239
  240                         	; ---- game state
  241 00ce 212000             	ld	hl, 32
  242 00d1 2200c0             	ld	(px_lo), hl
  243 00d4 21a000             	ld	hl, 160
  244 00d7 2202c0             	ld	(py_lo), hl
  245 00da af                 	xor	a
  246 00db 3204c0             	ld	(xvel), a
  247 00de 3205c0             	ld	(xfrac), a
  248 00e1 3206c0             	ld	(yvel), a
  249 00e4 3207c0             	ld	(yfrac), a
  250 00e7 3208c0             	ld	(inair), a
  251 00ea 3211c0             	ld	(pad), a
  252 00ed 3212c0             	ld	(padPrev), a
  253 00f0 3214c0             	ld	(wiggly), a
  254 00f3 320bc0             	ld	(animTick), a
  255 00f6 320cc0             	ld	(animIdx), a
  256 00f9 3216c0             	ld	(coinCount), a
  257 00fc 3225c0             	ld	(frameCnt), a
  258 00ff 3215c0             	ld	(skidOld), a
  259 0102 3227c0             	ld	(skidNow), a
  260 0105 3c                 	inc	a
  261 0106 3209c0             	ld	(onGround), a
  262 0109 21ffff             	ld	hl, $FFFF
  263 010c 220dc0             	ld	(frameCur), hl		; frameCur and tileColCur = $FF
  264 010f 2140c0             	ld	hl, OVL_BASE
  265 0112 2223c0             	ld	(ovlEnd), hl
  266 0115 36ff               	ld	(hl), $FF
  267 0117 af                 	xor	a
  268 0118 3217c0             	ld	(sndPtr0), a
  269 011b 3218c0             	ld	(sndPtr0 + 1), a
  270 011e 3219c0             	ld	(sndPtr1), a
  271 0121 321ac0             	ld	(sndPtr1 + 1), a
  272 0124 321bc0             	ld	(sndPtr2), a
  273 0127 321cc0             	ld	(sndPtr2 + 1), a
  274 012a 321dc0             	ld	(sndPtr3), a
  275 012d 321ec0             	ld	(sndPtr3 + 1), a
  276
  277 0130 cda406             	call	CameraUpdate		; draws the first screen
  278
  279                         ;=====================================================================
  280                         MainLoop:
  281 0133 cd4801             	call	WaitVBlank
  282 0136 cd5501             	call	ReadPad
  283 0139 cd8b01             	call	PlayerPhysics
  284 013c cda406             	call	CameraUpdate
  285 013f cd4d07             	call	DrawMario
  286 0142 cd3708             	call	SoundUpdate
  287 0145 c33301             	jp	MainLoop
  288
  289                         ;=====================================================================
  290                         WaitVBlank:
  291                         waitvb:
  292 0148 dbbf               	in	a, (VDP_CTRL)
  293 014a 87                 	add	a, a
  294 014b 30fb               	jr	nc, waitvb
  295 014d 2a25c0             	ld	hl, (frameCnt)
  296 0150 23                 	inc	hl
  297 0151 2225c0             	ld	(frameCnt), hl
  298 0154 c9                 	ret
  299
  300                         ;=====================================================================
  301                         ReadPad:
  302 0155 dbc0               	in	a, (PAD_PORT)
  303 0157 2f                 	cpl
  304 0158 47                 	ld	b, a
  305 0159 af                 	xor	a
  306 015a cb58               	bit	3, b
  307 015c 2802               	jr	z, rp1
  308 015e f601               	or	PAD_RIGHT
  309                         rp1:
  310 0160 cb50               	bit	2, b
  311 0162 2802               	jr	z, rp2
  312 0164 f602               	or	PAD_LEFT
  313                         rp2:
  314 0166 cb60               	bit	4, b
  315 0168 2802               	jr	z, rp3
  316 016a f604               	or	PAD_A
  317                         rp3:
  318 016c cb68               	bit	5, b
  319 016e 2802               	jr	z, rp4
  320 0170 f608               	or	PAD_B
  321                         rp4:
  322 0172 3211c0             	ld	(pad), a
  323 0175 2112c0             	ld	hl, padPrev
  324 0178 4e                 	ld	c, (hl)
  325 0179 77                 	ld	(hl), a
  326 017a 47                 	ld	b, a
  327 017b 79                 	ld	a, c
  328 017c 2f                 	cpl
  329 017d a0                 	and	b
  330 017e 3213c0             	ld	(padEdge), a
  331 0181 c9                 	ret
  332
  333                         ;=====================================================================
  334                         ; |xvel| in a (Z set when zero)
  335                         AbsXVel:
  336 0182 3a04c0             	ld	a, (xvel)
  337 0185 cb7f               	bit	7, a
  338 0187 c8                 	ret	z
  339 0188 ed44               	neg
  340 018a c9                 	ret
  341
  342                         ;=====================================================================
  343                         .include "physics.z80"
    1                         ;=====================================================================
    2                         ; physics.z80 - port of PRG008 player physics (small Mario, overworld)
    3                         ;
    4                         ;   Player_GroundHControl / Player_JumpFlyFlutter / gravity /
    5                         ;   Player_ApplyXVelocity / Player_ApplyYVelocity plus tile collision
    6                         ;=====================================================================
    7
    8                         PlayerPhysics:
    9 018b af                 	xor	a
   10 018c 3227c0             	ld	(skidNow), a
   11
   12                         	; ---------------- horizontal control ----------------
   13 018f 3a11c0             	ld	a, (pad)
   14 0192 3222c0             	ld	(tmp4), a		; pad copy
   15 0195 e603               	and	PAD_LEFT | PAD_RIGHT
   16 0197 321fc0             	ld	(tmp1), a		; dirPressed mask
   17
   18                         	; top speed: B held -> run
   19 019a 3a22c0             	ld	a, (tmp4)
   20 019d e608               	and	PAD_B
   21 019f 3e28               	ld	a, P_TOPRUN
   22 01a1 2002               	jr	nz, ph_ts
   23 01a3 3e18               	ld	a, P_TOPWALK
   24                         ph_ts:
   25 01a5 3221c0             	ld	(tmp3), a
   26
   27                         	; accel table index: small Mario base 0, +4 with B
   28 01a8 3a22c0             	ld	a, (tmp4)
   29 01ab e608               	and	PAD_B
   30 01ad 0600               	ld	b, 0
   31 01af 2802               	jr	z, ph_yi
   32 01b1 0604               	ld	b, 4
   33                         ph_yi:
   34 01b3 3a1fc0             	ld	a, (tmp1)
   35 01b6 b7                 	or	a
   36 01b7 284c               	jr	z, ph_nodir
   37
   38                         	; ---- pressing a direction
   39 01b9 04                 	inc	b
   40 01ba 04                 	inc	b			; skid entry
   41 01bb cd8201             	call	AbsXVel
   42 01be 3222c0             	ld	(tmp4), a		; |xvel|
   43 01c1 4f                 	ld	c, a			; keep |xvel|
   44 01c2 3a04c0             	ld	a, (xvel)
   45 01c5 67                 	ld	h, a			; signed xvel
   46 01c6 3a1fc0             	ld	a, (tmp1)
   47 01c9 e601               	and	PAD_RIGHT
   48 01cb 2806               	jr	z, ph_revL
   49 01cd cb7c               	bit	7, h			; right pressed: reversing if xvel<0
   50 01cf 201e               	jr	nz, ph_rev
   51 01d1 1804               	jr	ph_norev
   52                         ph_revL:
   53 01d3 cb7c               	bit	7, h			; left pressed: reversing if xvel>0
   54 01d5 2818               	jr	z, ph_rev
   55                         ph_norev:
   56 01d7 05                 	dec	b			; normal entry
   57 01d8 3a21c0             	ld	a, (tmp3)
   58 01db b9                 	cp	c
   59 01dc 2003               	jr	nz, ph_nt1
   60 01de c37202             	jp	ph_hdone		; exactly top speed: nothing
   61                         ph_nt1:
   62 01e1 302e               	jr	nc, ph_happly		; below top: normal accel
   63 01e3 3a09c0             	ld	a, (onGround)		; above top
   64 01e6 b7                 	or	a
   65 01e7 2003               	jr	nz, ph_nt2
   66 01e9 c37202             	jp	ph_hdone		; in air: nothing
   67                         ph_nt2:
   68 01ec 05                 	dec	b			; friction entry
   69 01ed 1822               	jr	ph_happly
   70                         ph_rev:
   71 01ef 79                 	ld	a, c
   72 01f0 b7                 	or	a
   73 01f1 287f               	jr	z, ph_hdone		; standing: no skid
   74                         	; skid entry (b already skid)
   75 01f3 3a09c0             	ld	a, (onGround)
   76 01f6 b7                 	or	a
   77 01f7 2818               	jr	z, ph_happly
   78 01f9 79                 	ld	a, c
   79 01fa fe10               	cp	$10
   80 01fc 3813               	jr	c, ph_happly
   81 01fe 3e01               	ld	a, 1
   82 0200 3227c0             	ld	(skidNow), a
   83 0203 180c               	jr	ph_happly
   84
   85                         ph_nodir:
   86 0205 3a09c0             	ld	a, (onGround)
   87 0208 b7                 	or	a
   88 0209 2867               	jr	z, ph_hdone		; in air, no input: nothing
   89 020b 3a04c0             	ld	a, (xvel)
   90 020e b7                 	or	a
   91 020f 2861               	jr	z, ph_hdone		; stopped: nothing
   92                         	; friction entry (b unchanged)
   93
   94                         ph_happly:
   95 0211 58                 	ld	e, b
   96 0212 1600               	ld	d, 0
   97 0214 21e805             	ld	hl, AccelMain
   98 0217 19                 	add	hl, de
   99 0218 7e                 	ld	a, (hl)
  100 0219 3222c0             	ld	(tmp4), a
  101 021c 21f005             	ld	hl, AccelPseudo
  102 021f 19                 	add	hl, de
  103 0220 7e                 	ld	a, (hl)
  104 0221 4f                 	ld	c, a
  105 0222 3a14c0             	ld	a, (wiggly)
  106 0225 81                 	add	a, c
  107 0226 3e00               	ld	a, 0
  108 0228 ce00               	adc	a, 0
  109 022a 4f                 	ld	c, a			; ripple carry
  110 022b 3a22c0             	ld	a, (tmp4)
  111 022e 81                 	add	a, c
  112 022f 3222c0             	ld	(tmp4), a		; acc
  113                         	; direction: pad direction if pressed, else sign of xvel
  114 0232 3a1fc0             	ld	a, (tmp1)
  115 0235 b7                 	or	a
  116 0236 2009               	jr	nz, ph_dir1
  117 0238 3a04c0             	ld	a, (xvel)
  118 023b cb7f               	bit	7, a
  119 023d 2006               	jr	nz, ph_left
  120 023f 180c               	jr	ph_right
  121                         ph_dir1:
  122 0241 e601               	and	PAD_RIGHT
  123 0243 2008               	jr	nz, ph_right
  124                         ph_left:
  125 0245 3a22c0             	ld	a, (tmp4)
  126 0248 ed44               	neg
  127 024a 3222c0             	ld	(tmp4), a
  128                         ph_right:
  129 024d 3a04c0             	ld	a, (xvel)
  130 0250 4f                 	ld	c, a
  131 0251 3a22c0             	ld	a, (tmp4)
  132 0254 81                 	add	a, c
  133 0255 3204c0             	ld	(xvel), a
  134                         	; clamp to +- P_MAXSPEED
  135 0258 cd8201             	call	AbsXVel
  136 025b fe41               	cp	P_MAXSPEED + 1
  137 025d 3813               	jr	c, ph_hdone
  138 025f 3a04c0             	ld	a, (xvel)
  139 0262 cb7f               	bit	7, a
  140 0264 2007               	jr	nz, ph_clampN
  141 0266 3e40               	ld	a, P_MAXSPEED
  142 0268 3204c0             	ld	(xvel), a
  143 026b 1805               	jr	ph_hdone
  144                         ph_clampN:
  145 026d 3ec0               	ld	a, 0 - P_MAXSPEED
  146 026f 3204c0             	ld	(xvel), a
  147                         ph_hdone:
  148                         	; Counter_Wiggly ripple (PRG008: w = (w & $F0) - $90)
  149 0272 3a14c0             	ld	a, (wiggly)
  150 0275 e6f0               	and	$F0
  151 0277 d690               	sub	$90
  152 0279 3214c0             	ld	(wiggly), a
  153
  154                         	; ---------------- jump (Player_JumpFlyFlutter) ----------------
  155 027c 3a13c0             	ld	a, (padEdge)
  156 027f e604               	and	PAD_A
  157 0281 2830               	jr	z, ph_nojump
  158 0283 3a09c0             	ld	a, (onGround)
  159 0286 b7                 	or	a
  160 0287 282a               	jr	z, ph_nojump
  161 0289 cd8201             	call	AbsXVel
  162 028c 1f                 	rra
  163 028d 1f                 	rra
  164 028e 1f                 	rra
  165 028f 1f                 	rra
  166 0290 fe04               	cp	4
