;=====================================================================
; camera.z80 - level tile access, overlay and the scrolling camera
;
; The TMS9918A has no scroll registers: PNT column x always shows
; level column cam+x, so every camera-column change repaints the
; whole 32-column window. The row-major sweep in RedrawWindow costs
; ~30k T-states (half a frame), so the full redraw fits in one
; vblank period even at top run speed, where a camera column lasts
; two frames - the screen is never partially stale.
;=====================================================================

; d = column, e = row -> a = tile (overlay first, then ROM)
TileAt:
	ld	hl, OVL_BASE
ta_l:
	ld	a, (hl)
	cp	$FF
	jr	z, ta_rom
	cp	d
	jr	nz, ta_n
	inc	hl
	ld	a, (hl)
	dec	hl
	cp	e
	jr	nz, ta_n
	inc	hl
	inc	hl
	ld	a, (hl)
	dec	hl
	dec	hl
	ret
ta_n:
	inc	hl
	inc	hl
	inc	hl
	jr	ta_l
ta_rom:
	push	de
	ld	h, 0
	ld	l, d
	add	hl, hl		; x2
	add	hl, hl		; x4
	add	hl, hl		; x8
	ld	d, h
	ld	e, l
	add	hl, hl		; x16
	add	hl, de		; x24
	pop	de
	ld	d, 0
	add	hl, de
	ld	de, LevelData
	add	hl, de
	ld	a, (hl)
	ret

; d = column, e = row, c = new tile
OvlSet:
	ld	hl, OVL_BASE
os_l:
	ld	a, (hl)
	cp	$FF
	jr	z, os_add
	cp	d
	jr	nz, os_n
	inc	hl
	ld	a, (hl)
	dec	hl
	cp	e
	jr	nz, os_n
	inc	hl
	inc	hl
	ld	(hl), c
	ret
os_n:
	inc	hl
	inc	hl
	inc	hl
	jr	os_l
os_add:
	ld	(hl), d
	inc	hl
	ld	(hl), e
	inc	hl
	ld	(hl), c
	inc	hl
	ld	(hl), $FF
	ld	(ovlEnd), hl
	ret

; Full background redraw. The TMS9918A has no scroll registers: PNT
; column x always shows level column cam+x, so every camera-column
; change must repaint the whole 32-column window. The sweep is row
; major: one VDP address set per row, then 32 back-to-back data
; writes (the VDP auto-increments), source stride 24. Rows 0-3 are
; permanent sky (PNT cleared at boot, never redrawn).
; Cost: 640 tiles x ~42T + overhead ~ 30k T-states: one frame.
; tmp4 = camera column.
RedrawWindow:
	ld	a, (tmp4)
	ld	l, a
	ld	h, 0
	add	hl, hl
	add	hl, hl
	add	hl, hl		; *8
	ld	e, l
	ld	d, h
	add	hl, hl		; *16
	add	hl, de		; *24
	ld	de, LevelData
	add	hl, de
	ld	(rwBase), hl
	ld	hl, VRAM_PNT + 4 * 32
	ld	(paP), hl		; row address cursor
	ld	c, 4			; row
rw_row:
	ld	hl, (rwBase)
	ld	b, 0
	add	hl, bc		; source = base + row
	ld	a, (paP)
	out	(VDP_CTRL), a
	ld	a, (paP + 1)
	or	$40
	out	(VDP_CTRL), a
	ld	de, 24		; source stride
	ld	b, 32
rw_x:
	ld	a, (hl)
	out	(VDP_DATA), a
	add	hl, de
	djnz	rw_x
	ld	a, (paP)
	add	a, 32
	ld	(paP), a
	ld	a, (paP + 1)
	adc	a, 0
	ld	(paP + 1), a
	inc	c
	ld	a, c
	cp	24
	jr	nz, rw_row
	ret

; repaint overlay entries (used blocks, collected coins) over the ROM
; sweep; slot = (col, row, tile), col $FF terminates
RedrawOvl:
	ld	hl, OVL_BASE
ro_l:
	ld	a, (hl)
	cp	$FF
	ret	z
	ld	(tmp1), a		; col
	inc	hl
	ld	a, (hl)
	ld	(tmp2), a		; row
	inc	hl
	ld	a, (hl)
	ld	(tmp3), a		; tile
	inc	hl
	push	hl
	ld	a, (tmp4)
	ld	e, a
	ld	a, (tmp1)
	sub	e
	jr	c, ro_next		; left of window
	cp	32
	jr	nc, ro_next		; right of window
	ld	e, a			; screen x
	ld	a, (tmp2)
	cp	4
	jr	c, ro_next
	cp	24
	jr	nc, ro_next
	ld	d, a			; row
	ld	h, 0
	ld	l, d
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl		; row*32
	ld	d, 0
	add	hl, de
	ld	de, VRAM_PNT
	add	hl, de
	call	VdpSetAddrW
	ld	a, (tmp3)
	out	(VDP_DATA), a
ro_next:
	pop	hl
	jr	ro_l

OvlSetPoke:
	call	OvlSet
	push	bc
	push	de
	ld	hl, (cam_lo)
	srl	h
	rr	l
	srl	h
	rr	l
	srl	h
	rr	l			; hl = camera column
	ld	a, d
	sub	l
	jr	c, osp_out		; left of the window
	cp	32
	jr	nc, osp_out		; right of the window
	ld	(tmp3), a		; screen x
	ld	h, 0
	ld	l, e			; row
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl
	add	hl, hl		; row*32
	ld	a, (tmp3)
	ld	e, a
	ld	d, 0
	add	hl, de
	ld	de, VRAM_PNT
	add	hl, de
	call	VdpSetAddrW
	ld	a, c
	out	(VDP_DATA), a
osp_out:
	pop	de
	pop	bc
	ret

;=====================================================================
CameraUpdate:
	; cam = clamp(px - 96, 0, LEVEL_MAXCAM)
	ld	hl, (px_lo)
	ld	de, 96
	or	a
	sbc	hl, de
	bit	7, h
	jr	z, cu_pos
	ld	hl, 0
cu_pos:
	ld	de, LEVEL_MAXCAM
	or	a
	sbc	hl, de
	jr	nc, cu_max
	add	hl, de		; below max: restore px-96
	jr	cu_ok
cu_max:
	ld	hl, LEVEL_MAXCAM
cu_ok:
	ld	(cam_lo), hl
	srl	h
	rr	l
	srl	h
	rr	l
	srl	h
	rr	l
	ld	a, l
	ld	(tmp4), a		; new column
	; The TMS9918A has no scroll registers: PNT column x always shows
	; level column cam+x, so ANY camera-column change must repaint the
	; whole 32-column window. The row-major sweep (RedrawWindow) costs
	; ~30k T-states, so the full redraw fits in ONE frame even at run
	; speed (a camera column lasts >= 2 frames) - no conveyor, no
	; partially-stale screen.
	ld	a, (tileColCur)
	cp	$FF
	jr	z, cu_redraw
	ld	b, a
	ld	a, (tmp4)
	sub	b
	ret	z			; camera column unchanged
cu_redraw:
	ld	a, (tmp4)
	ld	(tileColCur), a
	call	RedrawWindow
	call	RedrawOvl
	ret
